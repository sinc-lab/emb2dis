FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4

WORKDIR /app

COPY requirements-container.txt .
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.9.1 \
 && pip install -r requirements-container.txt

COPY src/ /app/src/
COPY config/ /app/config/
COPY model/ /app/model/
COPY predict_disorder_ensemble.py /app/

ENTRYPOINT ["python", "/app/predict_disorder_ensemble.py", \
            "--model", "ESM2", \
            "--device", "cpu", \
            "--caid", \
            "--fasta", "/data/input.fasta", \
            "--embeddings-dir", "/data/embeddings", \
            "--output-dir", "/data/output", \
            "--threads", "4"]

CMD []
